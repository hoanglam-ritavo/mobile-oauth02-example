# Bắt buộc. Origin của External Backend (C) mà thiết bị truy cập được.
# Gồm scheme, host và port nếu có. Không kèm path như /api. Bản release yêu cầu HTTPS.
EXPO_PUBLIC_APP_BACKEND_BASE_URL=https://app.example.invalid

# Tùy chọn. Deep link D dùng để mở màn cấp quyền của B. Giá trị mẫu cũng là mặc định.
EXPO_PUBLIC_RITA_APP_AUTHORIZE_URL=rita-id://oauth/authorize

# B quay về D qua callback cố định rita-partner-demo://redirect.
# D nhận client_id từ C khi khởi tạo đăng nhập.

# Thiết lập tùy chọn trong PowerShell khi build Android trên Windows.
# $env:ANDROID_HOME = "$env:LOCALAPPDATA\Android\Sdk"
