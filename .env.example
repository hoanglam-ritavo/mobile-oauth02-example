# Public configuration for D. Keep Rita client secrets at C.
# Use the C origin only. Release builds require HTTPS.
EXPO_PUBLIC_APP_BACKEND_BASE_URL=https://app.example.invalid
# D opens B at this entry URL.
# B returns to D at rita-partner-demo://redirect, fixed by RITA_CALLBACK_URI in D.
EXPO_PUBLIC_RITA_APP_AUTHORIZE_URL=rita-id://oauth/authorize
