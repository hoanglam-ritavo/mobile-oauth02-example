# Public bundle configuration. Use HTTPS for release; HTTP only in development.
EXPO_PUBLIC_OAUTH_CLIENT_ID=replace-with-registered-public-mobile-client-id
EXPO_PUBLIC_OAUTH_REDIRECT_URI=rita-id-app://redirect
# Rita ID portal origin; its API is origin + /api.
EXPO_PUBLIC_RITA_BASE_URL=https://id.example.com
# Application B (OAuth Web Example phase 2), origin only.
EXPO_PUBLIC_APP_BACKEND_BASE_URL=https://app.example.com
